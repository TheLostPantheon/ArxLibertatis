+// Reuse the vertex program patched for the previous draw while the attribute layout is the
+// same: the shader patcher hashes the layout to look the program up (and adds a reference to
+// it) on every call, a sizable part of each draw's CPU cost
+#define patchVertexProgramIfChanged(p, attributes, streams) \
+	if (!p->vprog || p->vprog != p->patched_vprog || p->patched_num != p->attr_num || \
+		sceClibMemcmp(p->patched_attr, attributes, sizeof(SceGxmVertexAttribute) * p->attr_num) || \
+		sceClibMemcmp(p->patched_stream, streams, sizeof(SceGxmVertexStream) * p->attr_num)) { \
+		patchVertexProgram(gxm_shader_patcher, p->vshader->id, attributes, p->attr_num, streams, p->attr_num, &p->vprog); \
+		vgl_fast_memcpy(p->patched_attr, attributes, sizeof(SceGxmVertexAttribute) * p->attr_num); \
+		vgl_fast_memcpy(p->patched_stream, streams, sizeof(SceGxmVertexStream) * p->attr_num); \
+		p->patched_vprog = p->vprog; \
+		p->patched_num = p->attr_num; \
+	}
+
 // Internal shaders and array
 static shader shaders[MAX_CUSTOM_SHADERS];
 static program progs[MAX_CUSTOM_PROGRAMS];
